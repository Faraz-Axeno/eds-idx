  "models": [
    {
      "id": "jsw-footer",
      "fields": [
        {
          "component": "tab",
          "name": "tab_footer",
          "label": "Footer"
        },
        {
          "component": "select",
          "name": "media_footerVariant",
          "label": "Footer layout",
          "description": "Variant A: the photo (or video) behind; the logo, copyright and button at the left, the columns and social icons at the right. Variant B: the black-to-teal gradient (no photo); the logo, copyright and privacy policy at the left, the button in the centre, CONNECT (the social links as text) and the columns at the right. The columns and social icons: the Columns and Social icons tabs.",
          "valueType": "string",
          "value": "variant-phase-5",
          "required": true,
          "options": [
            {
              "name": "Variant A",
              "value": "variant-phase-5"
            },
            {
              "name": "Variant B",
              "value": "variant-phase-3"
            }
          ]
        },
        {
          "component": "select",
          "name": "media_backgroundMode",
          "label": "Background type",
          "description": "Image: the background image. Video: the background video, playing muted on a loop (the background image shows until it plays, and instead of it if it cannot).",
          "valueType": "string",
          "value": "image",
          "required": true,
          "options": [
            {
              "name": "Image",
              "value": "image"
            },
            {
              "name": "Video",
              "value": "video"
            }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "media_backgroundImage",
          "label": "Background image",
          "description": "Covers the whole footer (with Video: shown until the video plays).",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "media_backgroundImageAlt",
          "label": "Background image alt text",
          "description": "Leave empty when the image is decoration only. At most 125 characters.",
          "value": "",
          "validation": {
            "maxLength": 125
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "media_backgroundVideo",
          "label": "Background video",
          "description": "An MP4 video from Assets, or its full URL. Used when Background type is Video.",
          "condition": {
            "===": [
              {
                "var": "media_backgroundMode"
              },
              "video"
            ]
          }
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "brand_logo",
          "label": "Logo",
          "description": "The JSW MOTORS wordmark, white.",
          "multi": false,
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "brand_logoAlt",
          "label": "Logo alt text",
          "value": "JSW Motors",
          "validation": {
            "maxLength": 40
          }
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "brand_copyright",
          "label": "Copyright text",
          "description": "Under the logo, e.g. © 2026 JSW Motors  Mumbai, India. At most 60 characters.",
          "value": "© 2026 JSW Motors  Mumbai, India",
          "required": true,
          "validation": {
            "maxLength": 60
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "brand_ctaButton",
          "label": "CTA button link",
          "description": "Where the white button leads (a page, or #section on one).",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "brand_ctaButtonText",
          "label": "CTA button text",
          "description": "The \"+\" after it is added on the page. At most 24 characters.",
          "value": "REGISTER INTEREST",
          "required": true,
          "validation": {
            "maxLength": 24
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "brand_privacyPolicy",
          "label": "Privacy policy link",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "brand_privacyPolicyText",
          "label": "Privacy policy text",
          "description": "At the foot, on the left. At most 30 characters.",
          "value": "PRIVACY POLICY",
          "required": true,
          "validation": {
            "maxLength": 30
          }
        },
        {
          "component": "tab",
          "name": "tab_columns",
          "label": "Columns"
        },
        {
          "component": "container",
          "name": "footerColumns",
          "label": "Columns",
          "multi": true,
          "description": "The navigation columns, left to right: each its title and its links.",
          "fields": [
            {
              "component": "text",
              "valueType": "string",
              "name": "columnHeading",
              "label": "Column title",
              "description": "e.g. TECHNOLOGY. At most 20 characters.",
              "required": true,
              "validation": {
                "maxLength": 20
              }
            },
            {
              "component": "container",
              "name": "columnLinks",
              "label": "Links",
              "multi": true,
              "description": "Warning: You can add multiple links, but a maximum of 4 will be displayed on the live site.",
              "fields": [
                {
                  "component": "aem-content",
                  "valueType": "string",
                  "name": "link",
                  "label": "URL",
                  "description": "A page, #section, or a full URL.",
                  "required": true
                },
                {
                  "component": "text",
                  "valueType": "string",
                  "name": "linkText",
                  "label": "Label",
                  "description": "e.g. NEVs. At most 24 characters.",
                  "required": true,
                  "validation": {
                    "maxLength": 24
                  }
                }
              ]
            }
          ]
        },
        {
          "component": "tab",
          "name": "tab_social",
          "label": "Social icons"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "brand_socialHeading",
          "label": "Social heading",
          "description": "Above the social icons, e.g. CONNECT. At most 20 characters.",
          "value": "CONNECT",
          "required": true,
          "validation": {
            "maxLength": 20
          }
        },
        {
          "component": "container",
          "name": "socialIcons",
          "label": "Social icons",
          "multi": true,
          "description": "Warning: You can add multiple social icons, but a maximum of 4 will be displayed on the live site.",
          "fields": [
            {
              "component": "reference",
              "valueType": "string",
              "name": "iconImage",
              "label": "Icon",
              "description": "The network's logo, white on transparent (SVG or PNG).",
              "multi": false,
              "required": true
            },
            {
              "component": "text",
              "valueType": "string",
              "name": "iconImageAlt",
              "label": "Network name",
              "description": "e.g. Facebook: read out by screen readers, and shown as the link in the Variant B layout. At most 30 characters.",
              "required": true,
              "validation": {
                "maxLength": 30
              }
            },
            {
              "component": "aem-content",
              "valueType": "string",
              "name": "iconLink",
              "label": "URL",
              "description": "The JSW Motors profile on that network (full URL).",
              "required": true
            }
          ]
        },
