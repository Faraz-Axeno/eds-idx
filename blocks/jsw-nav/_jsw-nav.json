        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "cta",
          "label": "Button link",
          "description": "Where the white button leads.",
          "required": true
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "ctaText",
